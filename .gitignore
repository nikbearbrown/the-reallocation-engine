# ── The Reallocation Engine — Fall 2026 fresh cut ───────────────────────────
# Policy: commit samples, audits, and compact derived extracts; fetch bulk
# datasets via scripts/fetch/ (see DATA.md). Real personal data is NEVER
# tracked (DATA_CONTRACT.md §Zero-Conditions).

# OS / editor junk
**/.DS_Store
Thumbs.db
*.swp

# Node / Python
node_modules/
__pycache__/
*.pyc
.venv/
.env
.env.*

# Build outputs (regenerated by build.sh / CI)
/output/
/book/output/
/reports/generated/
.build/

# ── Bulk datasets: fetched, never committed (scripts/fetch/) ────────────────
/data/bls/zip/
/data/bls/db-30-2-text/
/data/bls/db-30-2-excel/
/data/bls/xls/
/data/sec/form-d/raw/
/data/sec/form-d/extracted/
/data/sec/form-d/processed/*.json
!/data/sec/form-d/processed/*sample*.json
/data/80-days-to-stay/scratch/

# ── Private layer: yours alone, never tracked ───────────────────────────────
/private/*
!/private/README.md
!/private/.gitkeep
/data/ats/*
!/data/ats/.gitignore
!/data/ats/portals.example.yml
/search/*
# Fictional committable example personas — the ONLY resume-shaped files
# that belong in git (DATA_CONTRACT.md §Zero-Conditions):
!/search/examples/
!/search/examples/**

# Belt-and-suspenders: resume artifacts are blocked everywhere else.
resume.json
**/*.resume.pdf
**/resume.pdf

# ── Film loops and reels (2026-09-17) ───────────────────────────────────────
